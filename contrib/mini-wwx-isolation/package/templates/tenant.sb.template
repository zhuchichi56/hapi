(version 1)

;; HAPI WWX guest Seatbelt profile. Installed root:wheel 0444 under
;; /Library/Application Support/HAPI-WWX-Isolation/policy/wwx.sb.
;; The whole hub/runner/CLI/agent process tree inherits this profile.
;;
;; Default deny. Broad read of immutable system files; explicit deny of the
;; owner home, /Volumes, /Network and /Users/Shared. Write only inside the WWX
;; home and standard devices. Network is loopback only, exact ports:
;;   HUB_PORT    hub bind/inbound and client/runner connect
;;   PROXY_PORT  model proxy connect
;;   @GUEST_PORT_MIN@..@GUEST_PORT_MAX@  bounded private CLI control/MCP ports
;; Seatbelt rejects port ranges, so every private port is an exact literal.
;; There is deliberately no wildcard localhost rule, no 3006 owner hub, no 4150
;; upstream gateway, no 18080, no SSH, no LAN and no DNS.

(deny default)

(allow process*)
(allow sysctl-read)
(allow ipc-posix-shm*)

(allow file-read*)
(deny file-read*
    (subpath "@ADMIN_HOME@")
    (subpath "/Volumes")
    (subpath "/Network")
    (subpath "/Users/Shared"))
(deny file-read*
    (literal "/Users/@ADMIN_USER@"))

(allow file-write* (subpath "@TENANT_HOME@"))
(allow file-write*
    (literal "/dev/null")
    (literal "/dev/zero")
    (literal "/dev/stdout")
    (literal "/dev/stderr")
    (literal "/dev/tty"))

;; Fixed hub and model proxy.
(allow network-bind (local ip "localhost:@HUB_PORT@"))
(allow network-inbound (local ip "localhost:@HUB_PORT@"))
(allow network-outbound (remote ip "localhost:@HUB_PORT@"))
(allow network-outbound (remote ip "localhost:@PROXY_PORT@"))

;; Bounded private CLI control/MCP ports. Generated by install.sh; each line is
;; an exact literal. The patched CLI allocates only inside this pool.
@GUEST_PORT_RULES@

;; Control-plane binaries that would let the guest escape the fixed wrapper.
;; The independent UID already denies these; this is defence in depth.
(deny process-exec
    (literal "/bin/launchctl")
    (literal "/usr/bin/launchctl")
    (literal "/usr/bin/open")
    (literal "/usr/bin/osascript")
    (literal "/usr/bin/osacompile")
    (literal "/usr/bin/sudo")
    (literal "/usr/bin/su")
    (literal "/usr/sbin/sysadminctl")
    (literal "/usr/bin/security")
    (literal "/usr/bin/ssh")
    (literal "/usr/bin/scp")
    (literal "/usr/bin/sftp")
    (literal "/usr/bin/crontab")
    (literal "/usr/bin/at")
    (literal "/usr/bin/atq")
    (literal "/usr/bin/atrm"))

;; Codex app-server Unix sockets live only inside this tenant home.
(allow network-bind (local unix-socket (subpath "@TENANT_HOME@")))
(allow network-inbound (local unix-socket (subpath "@TENANT_HOME@")))
(allow network-outbound (remote unix-socket (subpath "@TENANT_HOME@")))

(allow process-info* (target same-sandbox))

;; Vendor CLIs use these UID-specific directories, root-created mode 0700.
(allow file-write* (subpath "/private/tmp/claude-560") (subpath "/private/tmp/codex-daemon-560"))
(allow signal (target same-sandbox))
(allow network-bind (local unix-socket (subpath "/private/tmp/codex-daemon-560")))
(allow network-inbound (local unix-socket (subpath "/private/tmp/codex-daemon-560")))
(allow network-outbound (remote unix-socket (subpath "/private/tmp/codex-daemon-560")))

(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo") (global-name "com.apple.cfprefsd.daemon") (global-name "com.apple.cfprefsd.agent"))
