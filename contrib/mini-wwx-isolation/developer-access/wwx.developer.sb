;; Control-plane binaries that would let the guest escape the fixed wrapper.
;; The independent UID already denies these; this is defence in depth.
(deny process-exec
    (literal "/bin/launchctl")
    (literal "/usr/bin/launchctl")
    (literal "/usr/bin/open")
    (literal "/usr/bin/osascript")
    (literal "/usr/bin/osacompile")
    (literal "/usr/bin/sudo")
    (literal "/usr/bin/su")
    (literal "/usr/sbin/sysadminctl"))

;; Codex app-server Unix sockets live only inside this tenant home.
(allow network-bind (local unix-socket (subpath "/Users/hapi-wwx")))
(allow network-inbound (local unix-socket (subpath "/Users/hapi-wwx")))
(allow network-outbound (remote unix-socket (subpath "/Users/hapi-wwx")))

(allow process-info* (target same-sandbox))

(allow file-write* (subpath "/private/tmp/claude-560") (subpath "/private/tmp/codex-daemon-560"))
(allow signal (target same-sandbox))

(allow network-bind (local unix-socket (subpath "/private/tmp/codex-daemon-560")))
(allow network-inbound (local unix-socket (subpath "/private/tmp/codex-daemon-560")))
(allow network-outbound (remote unix-socket (subpath "/private/tmp/codex-daemon-560")))

(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo") (global-name "com.apple.cfprefsd.daemon") (global-name "com.apple.cfprefsd.agent"))

;; Developer capabilities restored after Mac mini migration (2026-10-28).
;; Preserve tenant file boundaries and private owner loopback isolation.
(allow network-outbound (remote ip "localhost:18080"))
(allow file-write* (subpath "/private/tmp"))
