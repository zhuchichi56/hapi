(version 1)

;; HAPI WWX guest Seatbelt profile. Installed root:wheel 0444 under
;; /Library/Application Support/HAPI-WWX-Isolation/policy/wwx.sb.
;; The whole hub/runner/CLI/agent process tree inherits this profile.
;;
;; Default deny. Broad read of immutable system files; explicit deny of the
;; owner home, /Volumes, /Network and /Users/Shared. Write only inside the WWX
;; home and standard devices. Network is loopback only, exact ports:
;;   HUB_PORT    hub bind/inbound and client/runner connect
;;   PROXY_PORT  model proxy connect
;;   43100..43131  bounded private CLI control/MCP ports
;; Seatbelt rejects port ranges, so every private port is an exact literal.
;; There is deliberately no wildcard localhost rule, no 3006 owner hub, no 4150
;; upstream gateway, no 18080, no SSH, no LAN and no DNS.

(deny default)

(allow process*)
(allow sysctl-read)
(allow ipc-posix-shm*)

(allow file-read*)
(deny file-read*
    (subpath "/Users/zhuhe")
    (subpath "/Volumes")
    (subpath "/Network")
    (subpath "/Users/Shared"))
(deny file-read*
    (literal "/Users/zhuhe"))

(allow file-write* (subpath "/Users/hapi-wwx"))
(allow file-write*
    (literal "/dev/null")
    (literal "/dev/zero")
    (literal "/dev/stdout")
    (literal "/dev/stderr")
    (literal "/dev/tty"))

;; Fixed hub and model proxy.
(allow network-bind (local ip "localhost:3026"))
(allow network-inbound (local ip "localhost:3026"))
(allow network-outbound (remote ip "localhost:3026"))
(allow network-outbound (remote ip "localhost:4126"))

;; Bounded private CLI control/MCP ports. Generated by install.sh; each line is
;; an exact literal. The patched CLI allocates only inside this pool.
(allow network-bind (local ip "localhost:43100"))
(allow network-inbound (local ip "localhost:43100"))
(allow network-outbound (remote ip "localhost:43100"))
(allow network-bind (local ip "localhost:43101"))
(allow network-inbound (local ip "localhost:43101"))
(allow network-outbound (remote ip "localhost:43101"))
(allow network-bind (local ip "localhost:43102"))
(allow network-inbound (local ip "localhost:43102"))
(allow network-outbound (remote ip "localhost:43102"))
(allow network-bind (local ip "localhost:43103"))
(allow network-inbound (local ip "localhost:43103"))
(allow network-outbound (remote ip "localhost:43103"))
(allow network-bind (local ip "localhost:43104"))
(allow network-inbound (local ip "localhost:43104"))
(allow network-outbound (remote ip "localhost:43104"))
(allow network-bind (local ip "localhost:43105"))
(allow network-inbound (local ip "localhost:43105"))
(allow network-outbound (remote ip "localhost:43105"))
(allow network-bind (local ip "localhost:43106"))
(allow network-inbound (local ip "localhost:43106"))
(allow network-outbound (remote ip "localhost:43106"))
(allow network-bind (local ip "localhost:43107"))
(allow network-inbound (local ip "localhost:43107"))
