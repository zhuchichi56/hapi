+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+
+const { context } = vi.hoisted(() => ({ context: { token: 'synthetic-token', baseUrl: 'https://hub.example/', api: {} } }))
+vi.mock('@/lib/app-context', () => ({ useAppContext: () => context }))
+import { OrchestraBoard, taskHoverInfo, type OrchestraSnapshot, type OrchestraTask, type OrchestraTaskUsage } from './OrchestraBoard'
+
+const NOW = new Date().toISOString()
+const fetchMock = vi.fn()
+const usage: OrchestraTaskUsage = {
+    available: true, sourceAt: NOW,
+    model: { scope: 'planner_phase_turn', sourceAt: NOW, coverage: 'complete', responsePending: false, toolCalls: 7,
+        steps: { completed: 9, coverage: 'complete_for_completed_responses' },
+        tokens: { input: 1000, output: 50, cacheRead: 800, cacheWrite: 30, nativeTotal: null, derivedTotal: 1050 } },
+    executor: { scope: 'observed_executor_invocations_only', sourceAt: NOW, coverage: 'partial_observed_invocations_not_full_task_execution',
+        executionSeconds: 125, gap: 'only one invocation recorded', tokensSourceAt: NOW, steps: { completed: null },
+        tokens: { input: 400, output: 20, cacheRead: 300, cacheWrite: 10, nativeTotal: null, derivedTotal: 420 } },
+    wall: { seconds: 3600, scope: 'planner_turn' },
+    result: { metric: '同一输入本地读取中位数', before: 0.26368208, after: 0.107675, unit: 'ms', scope: '本地读取，非主机速度', source: 'synthetic' }
+}
+function task(overrides: Partial<OrchestraTask> = {}): OrchestraTask {
+    return { id: 'T9', title: 'Hover task', goal: '把任务总控做到可观测。', deliverables: [], acceptance: [], ownership: [], authorization: '', threadId: 't',
+        host: 'h', createdAt: NOW, checkpoint: '', expectedAt: null, execution: 'running', review: 'pending', archive: 'none', observedAt: NOW, sourceAt: NOW,
+        progress: '', latestAction: '', evidence: [], stale: false, attention: false, external: false,
+        presentation: { title: 'Hover task', delivery: '', summary: '', summaryAt: NOW, nextStep: '随后提交审阅。' }, ...overrides }
+}
+const snap = (tasks: OrchestraTask[]): OrchestraSnapshot => ({ version: 1, generatedAt: NOW, controllerThreadId: 'c', collector: { connected: true, stale: false }, tasks })
+const ok = (data: unknown) => ({ ok: true, status: 200, json: async () => data }) as Response
+
+describe('task usage on the hover card', () => {
+    beforeEach(() => { fetchMock.mockReset(); vi.stubGlobal('fetch', fetchMock) })
+    afterEach(() => { cleanup(); vi.unstubAllGlobals() })
+
+    it('shows model scope, steps vs tool calls, token split without native total, and result before→after', () => {
+        const info = taskHoverInfo(task({ investment: { taskUsage: usage } }))
+        expect(info.steps).toBe('规划会话本阶段回合：9 次（工具调用 7 次，另计）')
+        expect(info.tokenSplit).toContain('输入 1000（缓存读 800 / 写 30，已含在输入内）· 输出 50 · 合计 1050（输入+输出推算）')
+        expect(info.tokenSplit).toContain('覆盖完整')
+        expect(info.tokenSplit).toContain('更新 ')
+        expect(info.result).toBe('同一输入本地读取中位数：0.26368208 → 0.107675 ms（本地读取，非主机速度）')
+        expect(info.nextStep).toBe('随后提交审阅。')
+        expect(info.wall).toContain('规划回合')
+    })
+
+    it('labels execution as observed invocations only and keeps executor summary separate', () => {
+        const info = taskHoverInfo(task({ investment: { taskUsage: usage } }))
+        expect(info.execution).toContain('已观测执行者调用合计 2 分 5 秒')
+        expect(info.execution).toContain('不代表任务全部执行')
+        expect(info.executorLine).toContain('输入 400（缓存读 300 / 写 10')
+        expect(info.executorLine).toContain('请求数未知')
+        expect(info.executorLine).toContain('不相加')
+        expect(info.metricsKnown).toBe(true)
+    })
+
+    it('marks pending response and partial coverage; unknown steps stay unknown', () => {
+        const info = taskHoverInfo(task({ investment: { taskUsage: { ...usage, model: { ...usage.model, coverage: 'partial', responsePending: true, steps: { completed: null } } } } }))
+        expect(info.steps).toContain('未知')
+        expect(info.steps).toContain('当前响应用量待记录')
+        expect(info.tokenSplit).toContain('覆盖不完整')
+    })
+
+    it('does not show usage when unavailable, and keeps the old partial total behaviour', () => {
+        const info = taskHoverInfo(task({ investment: { taskUsage: { available: false }, phaseMetrics: { usage: { input: 10, output: 5 }, coverage: 'partial' } } }))
+        expect(info.steps).toBe('')
+        expect(info.tokens).toBe('15（覆盖不完整，仅已观测部分）')
+    })
+
+    it('renders in the real hover card and keeps curated goal/next step', async () => {
+        fetchMock.mockResolvedValue(ok(snap([task({ investment: { taskUsage: usage } })])))
+        render(<OrchestraBoard />)
+        const node = await screen.findByTestId('ob-tree-node')
+        fireEvent.mouseEnter(node)
+        const card = screen.getByTestId('ob-hovercard')
+        expect(card).toHaveTextContent('把任务总控做到可观测。')
+        expect(card).toHaveTextContent('0.26368208 → 0.107675 ms')
+        expect(card).toHaveTextContent('规划会话本阶段回合：9 次（工具调用 7 次，另计）')
+        expect(card).toHaveTextContent('已观测执行者调用合计')
+        expect(card).toHaveTextContent('随后提交审阅。')
+        expect(card.querySelector('[data-field="token-split"]')).toBeTruthy()
+        expect(card.querySelector('[data-field="executor-usage"]')).toBeTruthy()
+    })
+})
