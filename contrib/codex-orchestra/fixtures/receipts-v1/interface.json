  "x-contract": {
    "version": 1,
    "endpoint": "GET /decisions on the existing private Unix socket",
    "query": {
      "task": "optional exact taskId",
      "state": [
        "pending",
        "decided",
        "action-pending",
        "verified"
      ],
      "waiting": [
        "controller",
        "waiting-user",
        "waiting-external"
      ]
    },
    "http": {
      "readOnly": true,
      "socketMode": "0600",
      "socketParentMode": "0700",
      "owner": "current uid",
      "testDataAlwaysExcluded": true,
      "unknownOrRepeatedQuery": "400",
      "insecureSocket": "403",
      "mutations": "405"
    },
    "authorization": {
      "controllerId": "01a19339-39e6-7081-8920-82db9992402a",
      "trustBoundary": "Trusted private local operator supplies actor_id; not an authentication token. Never forward worker-provided actor identity to controller APIs."
    },
    "publicTransport": "snapshot.systemDecisions, exact T022-public-safe/v1; internal GET /decisions and CLI remain separate",
    "counts": {
      "decided": "Cumulative distinct firstDecidedAt != null including revoked and rework",
      "currentlyEffective": "Current chosen/action/verified not revoked",
      "awaitingExecution": "Current choice without actionConfirmedAt",
      "awaitingVerification": "actionConfirmedAt present, independently verifiedAt absent",
      "missingDueAt": "Unresolved missing deadlines; overdue=null if any are unknown",
      "pending": "Distinct non-revoked pending decisions, including rework",
      "overdue": "Distinct non-revoked, non-verified decisions with dueAt strictly before generatedAt",
      "actionPending": "Combined chosen unresolved execution/verification; includes decided before action start",
      "longestWait": "Seconds since current pendingSince for the longest currently pending decision; null if none",
      "pendingDecisionWait": "Same current pending-cycle basis as longestWait; rework resets pendingSince",
      "allUnresolvedWait": "Seconds since original receipt-triggeredAt for the longest unresolved decision; rework does not reset",
      "rework": "Distinct decisions ever reworked, including subsequently revoked decisions",
      "revoked": "Distinct revoked decisions; not included in active counts"
    },
    "latency": "One firstDecidedAt-triggeredAt(receipt first durable receivedAt) sample per decision, including revoked/reworked decisions. Nearest rank ceil(p*n), no interpolation, null without samples. All counts/latency share query filters.",
    "coverage": "start is first durable receipt collection or null; no predeployment history inferred; missing clocks remain unknown",
    "revision": "create with same initial payload/id is idempotent; updates require expectedRevision and append audit revision",
    "durableAck": "Only receive commit, never review acceptance. receivedAt is server time; occurredAt is producer time.",
    "queue": {
      "maxSendAttempts": 3,
      "claimLeaseSeconds": 30,
      "retryBackoffSeconds": [
        2,
        4
      ],
      "crash": "expired sending becomes unknown",
      "unknown": "Read/reconcile only; absent/failed read stays unknown",
      "recovery": "Existing daemon collector cadence/executor: bounded drain(5 per queue); explicit CLI also available; no new service/port/timer"
    },
    "wake": "Fixed authorized controller. post_command send uses a native-safe per-claim actionId; stable eventId remains in marker. HTTP200/ok requires read user marker [orchestra-receipt:eventId] with native turn ID; native errors are unknown unless explicit not-sent.",
    "invariants": [
      "Pass checklist requires evidence",
      "Controller review requires evidence and separate API",
      "Create decision requires durable receipt, exact linkage and prior controller review",
      "User/external choice requires independent authority identity and evidence",
      "execution-confirm records execution delivery evidence separately; verified additionally requires independent review. controller verifier distinct from owner/reporter and independent verification evidence",
      "Rework/revocation preserve immutable revision history",
      "Test ledger mode persists and is excluded unless explicitly queried by local API/CLI"
    ]
  }
}
